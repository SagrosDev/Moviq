    "components": {
        "schemas": {
            "InitialRegistrationRequest": {
                "type": "object",
                "properties": {
                    "ownerName": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "organizationName": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "email": {
                        "oneOf": [
                            {
                                "type": "string",
                                "format": "email",
                                "maxLength": 254
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "language": {
                        "type": "string",
                        "maxLength": 8
                    },
                    "region": {
                        "type": "string",
                        "maxLength": 8
                    },
                    "timezone": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "currency": {
                        "type": "string",
                        "maxLength": 8
                    },
                    "termsAccepted": {
                        "type": "boolean"
                    },
                    "privacyAccepted": {
                        "type": "boolean"
                    },
                    "termsVersion": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "privacyVersion": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "prohibitedDataAcknowledged": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "prohibitedDataAcknowledged"
                ]
            },
            "InitialRegistrationResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "language": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "language",
                    "status"
                ]
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "code": {
                        "type": "string"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "correlationId": {
                        "type": "string"
                    },
                    "invalidParams": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "code",
                    "correlationId",
                    "status",
                    "title",
                    "type"
                ]
            },
            "ProtectedMembership": {
                "type": "object",
                "properties": {
                    "membershipId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "organizationId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "role": {
                        "type": "string"
                    }
                },
                "required": [
                    "membershipId",
                    "organizationId",
                    "role"
                ]
            },
            "RegistrationVerificationRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "maxLength": 512
                    }
                }
            },
            "RegistrationVerificationResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "language": {
                        "type": "string"
                    },
                    "nextStep": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "language",
                    "nextStep",
                    "status"
                ]
            },
            "SystemPing": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "status"
                ]
            }
        },
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}