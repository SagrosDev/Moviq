            "get": {
                "operationId": "organizations_protected_membership_detail",
                "parameters": [
                    {
                        "in": "path",
                        "name": "membership_id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "organizations"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProtectedMembership"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/organizations/registrations/": {
            "post": {
                "operationId": "organizations_register_initial_owner",
                "tags": [
                    "organizations"
                ],
                "requestBody": {
                    "content": {
