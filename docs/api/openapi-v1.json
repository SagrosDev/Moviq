                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/InitialRegistrationRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/InitialRegistrationRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InitialRegistrationResponse"
                                }
                            }
