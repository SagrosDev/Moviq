{
  "name": "moviqo-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": ">=11 <12"
  },
  "scripts": {
    "install:locked": "npm run check:node && npm ci",
    "check:node": "node ./tests/build/check-node-version.mjs",
    "typecheck": "npm run check:node && tsc --noEmit",
    "dev": "vite",
    "test:unit": "tsc -p tsconfig.test.json && node ./tests/build/prepare-test-build.mjs && node .test-build/tests/unit/draft-state.test.cjs && node .test-build/tests/unit/non-authoritative-ui.test.cjs",
    "test:architecture": "node tests/architecture/frontend-boundaries.test.mjs",
    "test": "npm run check:node && npm run test:architecture && npm run test:unit",
    "build": "npm run check:node && tsc --noEmit && vite build && node ./tests/build/scan-static-artifact.mjs",
    "test:e2e": "npm run check:node && playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@xyflow/react": "12.11.2",
    "vite": "~8.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
